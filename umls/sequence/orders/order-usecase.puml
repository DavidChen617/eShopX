@startuml

title Order UseCase Flow

actor User
actor Admin
participant "Frontend" as FE
participant "API" as API
participant "Cache" as Cache
participant "CartRepository" as CartRepo
participant "ProductRepository" as ProductRepo
participant "OrderRepository" as OrderRepo
participant "PaymentRepository" as PaymentRepo
participant "ShipmentRepository" as ShipmentRepo
participant "LinePayService" as LinePay
participant "PayPalService" as PayPal
participant "ECPayService" as ECPay
participant "ECPay" as ECPayExternal

== Step 1：物流選擇（ECPay 選店頁）==

User -> FE : 點擊「前往結帳」
FE -> API : POST /orders/logistics-selection\n[Authorization: Bearer accessToken]
API -> Cache : SET logistics_session:{token} → userId\nTTL = 15min
note right : token = 新產生的 UUID\nuserId 從 JWT 取得
API -> ECPay : GetLogisticsSelectionHtml(\n  serverReplyUrl,\n  clientReplyUrl = "/ecpay/client-reply?token={token}"\n)
ECPay -> ECPayExternal : POST /Express/v2/RedirectToLogisticsSelection
ECPayExternal --> ECPay : HTML（含 auto-submit form）
ECPay --> API : html
API --> FE : 200 text/html
FE -> FE : document.write(html)\n→ form 自動 submit\n→ 瀏覽器跳到 ECPay 選店頁

User -> ECPayExternal : 選擇超商門市（或填寫住家地址）
ECPayExternal -> API : POST /ecpay/client-reply?token={token}\n{ ResultData }（AES 加密）
API -> Cache : GET logistics_session:{token} → userId
alt token 不存在或已過期
    API --> ECPayExternal : 400
end
API -> ECPay : Decrypt(ResultData)
ECPay --> API : { TempLogisticsID, LogisticsSubType,\nReceiverName, ReceiverStoreID?, ReceiverAddress? }
API -> Cache : SET userId_logistics:{userId} → tempLogisticsData\nTTL = 15min
API -> Cache : DEL logistics_session:{token}
API --> FE : 302 Redirect\nhttps://frontend.com/checkout?tempLogisticsID=xxx&storeName=xxx
note right : 瀏覽器跳回前端結帳頁\n前端從 query string 拿 tempLogisticsID

== Step 2：建立訂單（含付款 + 物流）==

User -> FE : 選擇付款方式，確認下單
FE -> API : POST /orders\n{ paymentMethod, tempLogisticsID }
API -> Cache : Get(userId_logistics)

alt 暫存物流資料不存在（TTL 過期）
    API --> FE : 400 物流資訊已過期，請重新選擇
end

API -> CartRepo : GetByUserId(userId)

alt 購物車是空的
    API --> FE : 400 購物車是空的
end

loop 每個 CartItem
    API -> ProductRepo : GetSkuById(skuId)

    alt 商品已下架
        API --> FE : 400 商品已下架
    end

    alt 庫存不足
        API --> FE : 400 庫存不足
    end
end

loop 每個 CartItem（扣庫存）
    API -> ProductRepo : sku.DeductStock(quantity)
    note right
        樂觀鎖保護（xmin）
        DbUpdateConcurrencyException → 重試最多 3 次
        仍失敗 → 補回已扣庫存 → 400 系統繁忙
    end note
end

API -> OrderRepo : Order.Create(userId, items)

alt paymentMethod = LinePay
    API -> LinePay : RequestPayment(orderId, amount, confirmUrl, cancelUrl)
    LinePay -> ECPayExternal : POST /v3/payments/request
    ECPayExternal --> LinePay : { transactionId, paymentUrl }
else paymentMethod = PayPal
    API -> PayPal : GetAccessToken()
    API -> PayPal : CreateOrder(amount, returnUrl, cancelUrl)
    PayPal -> ECPayExternal : POST /v2/checkout/orders
    ECPayExternal --> PayPal : { id, links }
    note right : links 裡找 rel="approve" 的 href 作為 paymentUrl
end

API -> PaymentRepo : Payment.Create(orderId, method, amount, paymentUrl)

API -> ECPay : CreateByTempTrade(tempLogisticsID, merchantTradeNo)
ECPay -> ECPayExternal : POST /Express/v2/CreateByTempTrade
ECPayExternal --> ECPay : { RtnCode, LogisticsID }

alt RtnCode = 85002（地址無法識別）
    API -> ProductRepo : 補回所有庫存
    API -> OrderRepo : 刪除 Order
    API -> PaymentRepo : 刪除 Payment
    API --> FE : 400 地址格式無法識別，請重新選擇物流
    FE -> User : 提示錯誤，導回選店步驟
else RtnCode != 1（其他物流建立失敗）
    API -> ProductRepo : 補回所有庫存
    API -> OrderRepo : 刪除 Order
    API -> PaymentRepo : 刪除 Payment
    API --> FE : 500 物流建立失敗，請稍後再試
end

API -> ShipmentRepo : Shipment.Create(orderId, logisticsID, tempLogisticsData)
API -> CartRepo : cart.Clear()
API -> Cache : Delete(userId_logistics)

API --> FE : 200 { orderId, paymentUrl }
FE -> User : 導頁至付款頁

== 查看訂單列表 ==

User -> API : GET /orders\n[Authorization: Bearer accessToken]
API -> OrderRepo : GetByUserId(userId)
API --> User : 200 { orders: [{ id, status, totalAmount, createdAt }] }

== 查看訂單詳細 ==

User -> API : GET /orders/{id}
API -> OrderRepo : GetById(id)
alt 訂單不存在
    API --> User : 404 Not Found
end
API --> User : 200 { id, status, totalAmount,\npayment: { method, status },\nshipment: { subType, storeName?, address?, status } }

== Admin：列出待出貨訂單 ==

Admin -> API : GET /admin/orders?status=Paid
API -> OrderRepo : GetByStatus(Paid)
API --> Admin : 200 { orders: [{ id, userId, totalAmount, shipment }] }

== Admin：列印托運單 ==

Admin -> API : POST /admin/orders/{id}/print-label
API -> ShipmentRepo : GetByOrderId(id)
API -> ECPay : PrintTradeDocument(logisticsID, logisticsSubType)
ECPay -> ECPayExternal : POST /Express/v2/PrintTradeDocument
ECPayExternal --> ECPay : HTML（托運單）
ECPay --> API : html
API --> Admin : 200 { html }
note right : Admin 用瀏覽器開啟列印

== Admin：標記已出貨 ==

Admin -> API : PATCH /admin/orders/{id}/ship
API -> OrderRepo : GetById(id)
alt 訂單不存在
    API --> Admin : 404 Not Found
end
alt Status != Paid
    API --> Admin : 400 訂單尚未付款
end
participant "OutboxRepo" as OutboxRepo
participant "EmailService" as Email
participant "BackgroundJob" as BgJob

note over API, OutboxRepo
    以下在同一個 DB transaction 內執行
end note

API -> OrderRepo : order.MarkAsShipped()
API -> ShipmentRepo : shipment.UpdateStatus("出貨中")
API -> OutboxRepo : OutboxEvent.Create("OrderShipped", payload)
note right
    payload：
    { orderId, userId, shipmentType,
      storeName?, cvsPaymentNo?,
      bookingNote? }
end note

API --> Admin : 200 OK

== BackgroundJob：處理 Outbox 事件 ==

BgJob -> OutboxRepo : GetPendingEvents()
loop 每筆 Pending 事件
    alt EventType = "OrderShipped"
        BgJob -> Email : SendShippedNotification(payload)
        note right
            CVS：門市名稱 + 取件碼（CVSPaymentNo）
            HOME：黑貓托運單號（BookingNote）
        end note
        alt 寄送成功
            BgJob -> OutboxRepo : event.MarkAsProcessed()
        else 寄送失敗
            BgJob -> OutboxRepo : event.IncrementRetry()
            alt RetryCount >= 3
                BgJob -> OutboxRepo : event.MarkAsFailed()
                note right : 人工介入
            end
        end
    end
end

== BackgroundJob：Sandbox 自動完成訂單 ==

note over BgJob
    實作方式：Hangfire DelayedJob
    Admin 標記出貨時觸發：
    BackgroundJob.Schedule(() => CompleteShipment(orderId), TimeSpan.FromMinutes(30))

    正式環境：移除此 Job，改由 ECPay ServerReply 驅動
end note

BgJob -> ShipmentRepo : shipment.MarkAsCompleted()
note right : raises ShipmentCompletedEvent
BgJob -> OutboxRepo : OutboxEvent.Create("ShipmentCompleted",\n{ orderId, shipmentId })
BgJob -> OutboxRepo : event.MarkAsProcessed()

note over BgJob, OrderRepo
    ShipmentCompleted OutboxEvent 由另一個 BgJob 輪詢處理
end note
BgJob -> OrderRepo : order.MarkAsCompleted()

@enduml
