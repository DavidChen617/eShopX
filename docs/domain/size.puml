@startuml

package "Size Aggregate" {

    class Size <<AggregateRoot>> {
        + Id : Guid <<PK>>
        + Name : string
        + Type : SizeType
        + CreatedAt : DateTime
        + UpdatedAt : DateTime
        --
        + {static} Create(name, type) : Size
        + Rename(name) : void
    }

    enum SizeType {
        Clothing
        Pants
        Shoes
        Hat
    }

    Size --> SizeType
}

