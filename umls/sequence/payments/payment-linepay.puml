@startuml

title LinePay 付款流程

actor User
participant "API" as API
participant "PaymentRepository" as PaymentRepo
participant "OutboxRepo" as OutboxRepo
participant "LinePayService" as LinePay
participant "LINE Pay" as LinePayExternal

== 建立付款請求 ==

note over API
    建立訂單流程已在 order-usecase.puml 定義
    此流程從 User 點擊 paymentUrl 開始
end note

User -> LinePayExternal : 點 paymentUrl 付款
LinePayExternal --> User : 付款完成，redirect 到 ConfirmUrl\n?transactionId=xxx&orderId=xxx

== 確認付款 ==

User -> API : GET /payments/line/confirm\n?transactionId&orderId
API -> LinePay : ConfirmPayment(transactionId, amount, currency)
LinePay -> LinePayExternal : POST /v3/payments/{transactionId}/confirm
LinePayExternal --> LinePay : { ReturnCode, transactionId }

alt ReturnCode = "0000"（付款成功）
    note over API, OutboxRepo
        以下在同一個 DB transaction 內執行
    end note
    API -> PaymentRepo : payment.MarkAsPaid(transactionId)
    note right : raises PaymentPaidEvent
    API -> OutboxRepo : OutboxEvent.Create("PaymentPaid",\n{ orderId, transactionId })
    API --> User : Redirect /pay/line/success
else 付款失敗
    API -> PaymentRepo : payment.MarkAsFailed()
    note right : raises PaymentFailedEvent
    API -> OutboxRepo : OutboxEvent.Create("PaymentFailed",\n{ orderId, paymentId })
    API --> User : Redirect /pay/line/fail
end

== 取消付款 ==

User -> API : GET /payments/line/cancel?orderId=xxx
API -> PaymentRepo : payment.MarkAsFailed()
note right : raises PaymentFailedEvent
API -> OutboxRepo : OutboxEvent.Create("PaymentFailed",\n{ orderId, paymentId })
API --> User : Redirect /pay/line/fail?reason=cancelled

== BackgroundJob：處理付款事件 ==

participant "BackgroundJob" as BgJob
participant "OrderRepository" as OrderRepo

BgJob -> OutboxRepo : GetPendingEvents()

loop 每筆 Pending 事件
    alt EventType = "PaymentPaid"
        BgJob -> OrderRepo : order.MarkAsPaid()
        BgJob -> OutboxRepo : event.MarkAsProcessed()
    else EventType = "PaymentFailed"
        BgJob -> OrderRepo : 刪除 Order
        BgJob -> OutboxRepo : event.MarkAsProcessed()
    end
end

@enduml

