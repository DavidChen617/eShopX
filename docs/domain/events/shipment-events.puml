    Handler: ShipmentCompletedEventHandler
      → OutboxEvent.Create("ShipmentCompleted", payload)

    Payload:
    {
      "orderId": "...",
      "shipmentId": "..."
    }

    Background Job:
      → order.MarkAsCompleted()
end note

@enduml
