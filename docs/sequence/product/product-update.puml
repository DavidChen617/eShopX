@startuml product-update

title Product - 更新 & 圖片上傳流程

actor Admin
participant "API\n(Endpoint)" as API
participant "Handler\n(Use Case)" as Handler
participant "Redis\n(ICacher)" as Redis
participant "PostgreSQL\n(IProductRepository)" as DB
participant "Cloudinary\n(IImageStorage)" as Cloudinary
participant "Kafka\n(Outbox)" as Kafka
participant "Elasticsearch" as ES

== Update Product ==

group Pre-upload New Images (optional)
  Admin -> API : POST /admin/products/images\nmultipart files[]
  API -> Cloudinary : UploadAsync(files)
  Cloudinary --> API : [{ fileName, url, publicId }]
  API --> Admin : 200 [{ fileName, url, publicId }]
end

Admin -> API : PUT /admin/products/{productId}\n{ name, description, audience, categoryId,\n  tagIds, variants[{ variantId?, color,\n  skus[{ skuId?, sizeId, price, stock }],\n  images[{ url, publicId, isPrimary, sortOrder }] }] }
API -> Handler : UpdateProductCommand
Handler -> Handler : Validate
Handler -> DB : GetByIdAsync(productId)\nwith variants + skus + images
DB --> Handler : Product

Handler -> Handler : product.Update(name, desc, audience, categoryId)
Handler -> Handler : product.SyncTags(tagIds)

loop Each existing variant not in request
  loop Each image in variant
    Handler -> Cloudinary : DeleteAsync(publicId)
  end
  Handler -> Handler : product.RemoveVariant(variantId)
end

loop Each variant in request
  alt variantId exists
    Handler -> Handler : variant.UpdateColor(color)
  else new variant
    Handler -> Handler : product.AddVariant(color)
  end

  loop Each existing SKU not in request
    Handler -> Handler : variant.RemoveSku(skuId)
  end
  loop Each SKU in request
    alt skuId exists
      Handler -> Handler : sku.Update(price, stock)
    else new SKU
      Handler -> Handler : variant.AddSku(sizeId, price, stock)
    end
  end

  loop Each existing image not in request
    Handler -> Cloudinary : DeleteAsync(publicId)
    Handler -> Handler : variant.RemoveImage(imageId)
  end
  loop Each new image in request
    Handler -> Handler : variant.AddImage(url, publicId, isPrimary, sortOrder)
  end
end

Handler -> DB : SaveChanges\n→ ProductUpdatedEvent → OutboxEvent
Handler -> Redis : RemoveAsync(product:{id})
DB --> Handler : OK
Handler --> API : NoContent
API --> Admin : 204

Kafka -> ES : product.upsert\n→ re-index product

== Upload Image to Existing Variant ==

Admin -> API : POST /admin/products/{productId}/variants/{variantId}/images\nfile + ?isPrimary=&sortOrder=
API -> Handler : UploadProductImageCommand
Handler -> DB : GetByIdAsync(productId)
DB --> Handler : Product
Handler -> Handler : Find variant by variantId
Handler -> Cloudinary : UploadAsync(file)
Cloudinary --> Handler : { url, publicId }
Handler -> Handler : variant.AddImage(url, publicId, isPrimary, sortOrder)
Handler -> DB : SaveChanges\n→ ProductUpdatedEvent → OutboxEvent
DB --> Handler : OK
Handler --> API : UploadProductImageResponse
API --> Admin : 200 { imageId, url }

Kafka -> ES : product.upsert\n→ re-index product

@enduml
