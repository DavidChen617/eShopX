@startuml

title Payment Domain Events

package "Payment Events" {

    class PaymentPaidEvent <<DomainEvent>> {
        + PaymentId : Guid
        + OrderId : Guid
        + TransactionId : string
    }

    class PaymentFailedEvent <<DomainEvent>> {
        + PaymentId : Guid
        + OrderId : Guid
    }
}

note right of PaymentPaidEvent
    Raised by: payment.MarkAsPaid(transactionId)
    Handler: PaymentPaidEventHandler
      → OutboxEvent.Create("PaymentPaid", payload)

    Payload:
    {
      "orderId": "...",
      "transactionId": "..."
    }

    Background Job:
      → order.MarkAsPaid()
end note

note right of PaymentFailedEvent
    Raised by: payment.MarkAsFailed()
    Handler: PaymentFailedEventHandler
      → OutboxEvent.Create("PaymentFailed", payload)

    Payload:
    {
      "orderId": "...",
      "paymentId": "..."
    }

    Background Job:
      → 刪除 Order + Payment
end note

@enduml
