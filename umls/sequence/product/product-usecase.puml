@startuml

title Product UseCase Flow

actor Admin
participant "API" as API
participant "ProductRepository" as ProductRepo
participant "CategoryRepository" as CategoryRepo
participant "TagRepository" as TagRepo
participant "ImageStorage" as Storage

== 新增商品 ==

Admin -> API : POST /products\n{ name, description, gender, categoryId, tagIds[], isActive, variants[] }

API -> CategoryRepo : ExistsById(categoryId)
alt Category 不存在
    API --> Admin : 400 Category 不存在
end

API -> TagRepo : ExistsByIds(tagIds)
alt Tag 不存在
    API --> Admin : 400 Tag 不存在
end

API -> API : Product.Create(name, description, gender, categoryId, isActive)
loop 每個 Variant
    API -> API : product.AddVariant(color)
    loop 每個 Image
        API -> Storage : UploadAsync(image)
        API -> API : variant.AddImage(url, publicId, isPrimary, sortOrder)
    end
    loop 每個 Sku
        API -> API : variant.AddSku(sizeId, price, stock)
    end
end
loop 每個 TagId
    API -> API : product.AddTag(tagId)
end

API -> ProductRepo : Save()
API --> Admin : 201 { productId }

== 更新商品 ==

Admin -> API : PUT /products/{id}\n{ name?, description?, gender?, categoryId?, tagIds? }
API -> ProductRepo : GetById(id)
alt Product 不存在
    API --> Admin : 404 Not Found
end
API -> API : product.Update(command)
API -> ProductRepo : Save()
API --> Admin : 200 OK

== 上架 / 下架 ==

Admin -> API : PATCH /products/{id}/status\n{ isActive }
API -> ProductRepo : GetById(id)
alt isActive = true
    API -> API : product.Publish()
else
    API -> API : product.Unpublish()
end
API -> ProductRepo : Save()
API --> Admin : 200 OK

== 刪除商品 ==

Admin -> API : DELETE /products/{id}
API -> ProductRepo : GetById(id)
alt Product 不存在
    API --> Admin : 404 Not Found
end
API -> API : product.Delete()
note right : raises ProductDeletedEvent\n→ OutboxEvent → BgJob 清 ES + Redis
API -> ProductRepo : Save()
API --> Admin : 200 OK

@enduml
