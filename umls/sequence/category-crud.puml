@startuml category-crud

title Category CRUD Flow

actor User
actor Admin
participant "API\n(Endpoint)" as API
participant "Handler\n(Use Case)" as Handler
participant "PostgreSQL\n(ICategoryRepository)" as DB

== Get Categories (Public) ==

User -> API : GET /api/v1/categories
API -> Handler : GetCategoriesQuery
Handler -> DB : GetAllAsync()
DB --> Handler : List<Category>
Handler --> API : 200 [{ id, name, createdAt }]

== Create Category (Admin) ==

Admin -> API : POST /api/v1/admin/categories\n{ name }
API -> Handler : CreateCategoryCommand
Handler -> DB : AddAsync(category)
Handler -> DB : SaveChanges
Handler --> API : 201 { id, name, createdAt }

== Update Category (Admin) ==

Admin -> API : PUT /api/v1/admin/categories/{categoryId}\n{ name }
API -> Handler : UpdateCategoryCommand
Handler -> DB : GetByIdAsync(categoryId)
alt 找不到
  Handler --> API : 404 category_not_found
end
Handler -> Handler : category.Rename(name)
Handler -> DB : Update + SaveChanges
Handler --> API : 204

== Delete Category (Admin) ==

Admin -> API : DELETE /api/v1/admin/categories/{categoryId}
API -> Handler : DeleteCategoryCommand
Handler -> DB : GetByIdAsync(categoryId)
alt 找不到
  Handler --> API : 404 category_not_found
end
Handler -> DB : Delete + SaveChanges
Handler --> API : 204

@enduml
