@startuml

title Auth Login / Logout Flow

actor User
participant "API" as API
participant "UserRepository" as UserRepo
participant "UserAuthProvider" as AuthProvider
participant "PasswordHasher" as Hasher
participant "JwtService" as JWT
participant "RefreshTokenRepository" as TokenRepo

== 本地登入 ==

User -> API : POST /auth/login\n{ email, password }
API -> UserRepo : FindByEmail(email)

alt User 不存在
    API --> User : 400 帳號或密碼錯誤
end

API -> AuthProvider : FindByUserId(userId, provider: "local")

alt AuthProvider 不存在
    API --> User : 400 帳號或密碼錯誤
end

API -> Hasher : Verify(password, passwordHash)

alt 密碼錯誤
    API --> User : 400 帳號或密碼錯誤
end

API -> JWT : GenerateTokens(userId)
API -> TokenRepo : Save(refreshToken)
API --> User : 200 { accessToken, refreshToken }

== 登出 ==

User -> API : POST /auth/logout\n{ refreshToken }
API -> TokenRepo : Delete(refreshToken)
API --> User : 200 OK

@enduml
